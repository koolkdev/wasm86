{
  "name": "wasm86",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#build": {
      "types": "./src/build.js",
      "test": "./dist/test/build.js",
      "default": "./dist/src/build.js"
    },
    "#common/assert.js": {
      "types": "./src/common/assert.js",
      "test": "./dist/test/assert.js",
      "default": "./dist/src/common/assert.js"
    },
    "#cpu/*": {
      "types": "./src/cpu/*",
      "default": "./dist/src/cpu/*"
    },
    "#memory/*": {
      "types": "./src/memory/*",
      "default": "./dist/src/memory/*"
    },
    "#machine/*": {
      "types": "./src/machine/*",
      "default": "./dist/src/machine/*"
    },
    "#engines/*": {
      "types": "./src/engines/*",
      "default": "./dist/src/engines/*"
    },
    "#common/*": {
      "types": "./src/common/*",
      "default": "./dist/src/common/*"
    },
    "#compiler/*": {
      "types": "./src/compiler/*",
      "default": "./dist/src/compiler/*"
    },
    "#core/*": {
      "types": "./src/core/*",
      "default": "./dist/src/core/*"
    },
    "#ir/*": {
      "types": "./src/ir/*",
      "default": "./dist/src/ir/*"
    },
    "#wasm/*": {
      "types": "./src/wasm/*",
      "default": "./dist/src/wasm/*"
    },
    "#test/*": {
      "types": "./test/*",
      "default": "./dist/test/*"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run clean && tsc -p tsconfig.json && node --conditions=test --test 'dist/src/**/tests/*.test.js' 'dist/test/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
